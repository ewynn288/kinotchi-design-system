{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Kinotchi tokens: a colorful desktop digital-pet system built from ocean blue, candy pink, sunrise yellow, and habitat greens. The same roles are available in light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#E9FBFF" },
      "foreground": { "$value": "#073B5C" },
      "border": { "$value": "#8EE2EF" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#073B5C" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#073B5C" },
      "primary": {
        "$value": "#0A58CA",
        "$description": "Ocean blue for primary actions and focused navigation."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#FFD7E9" },
      "secondaryForeground": { "$value": "#8A1948" },
      "muted": { "$value": "#DFF7F8" },
      "mutedForeground": { "$value": "#27627B" },
      "accent": { "$value": "#FFE347" },
      "accentForeground": { "$value": "#5B3D00" },
      "destructive": { "$value": "#EF4D7A" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#B1EBEF" },
      "ring": { "$value": "#FFCB2F" },
      "chart1": { "$value": "#FF5D8F" },
      "chart2": { "$value": "#45D6D6" },
      "chart3": { "$value": "#7057D9" },
      "chart4": { "$value": "#FFD449" },
      "chart5": { "$value": "#73C95D" },
      "sidebar": { "$value": "#073B5C" },
      "sidebarForeground": { "$value": "#F4FEFF" },
      "sidebarBorder": { "$value": "#14658E" },
      "sidebarPrimary": { "$value": "#FFD836" },
      "sidebarPrimaryForeground": { "$value": "#073B5C" },
      "sidebarAccent": { "$value": "#0D4B73" },
      "sidebarAccentForeground": { "$value": "#F4FEFF" },
      "sidebarRing": { "$value": "#FFD836" }
    },
    "dark": {
      "background": { "$value": "#07164B" },
      "foreground": { "$value": "#FFF7E8" },
      "border": { "$value": "#2B4E86" },
      "card": { "$value": "#102A66" },
      "cardForeground": { "$value": "#FFF7E8" },
      "popover": { "$value": "#102A66" },
      "popoverForeground": { "$value": "#FFF7E8" },
      "primary": { "$value": "#54D9FF" },
      "primaryForeground": { "$value": "#062B58" },
      "secondary": { "$value": "#5F2B6D" },
      "secondaryForeground": { "$value": "#FFD7E9" },
      "muted": { "$value": "#163875" },
      "mutedForeground": { "$value": "#B7D7F6" },
      "accent": { "$value": "#FFE347" },
      "accentForeground": { "$value": "#5B3D00" },
      "destructive": { "$value": "#FF6A9B" },
      "destructiveForeground": { "$value": "#3E0730" },
      "input": { "$value": "#234884" },
      "ring": { "$value": "#FFE347" },
      "chart1": { "$value": "#FF76A7" },
      "chart2": { "$value": "#5FE6E2" },
      "chart3": { "$value": "#A797FF" },
      "chart4": { "$value": "#FFE36A" },
      "chart5": { "$value": "#8AE578" },
      "sidebar": { "$value": "#041238" },
      "sidebarForeground": { "$value": "#FFF7E8" },
      "sidebarBorder": { "$value": "#1F3A72" },
      "sidebarPrimary": { "$value": "#FFE347" },
      "sidebarPrimaryForeground": { "$value": "#07164B" },
      "sidebarAccent": { "$value": "#102A66" },
      "sidebarAccentForeground": { "$value": "#FFF7E8" },
      "sidebarRing": { "$value": "#FFE347" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Kosugi Maru", "Arial Rounded MT Bold", "sans-serif"],
        "$description": "Rounded Japanese display face supplied for Kinotchi's friendly, toy-like UI."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.25rem",
      "$description": "Soft, toy-like base radius for the egg shell, cards, and habitat frames."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base step for compact widget controls and pixel-grid rhythm."
    }
  }
}